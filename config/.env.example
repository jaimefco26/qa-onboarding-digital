# ─── API de practica (publica, sin credenciales reales) ───────────────────────
API_BASE_URL=https://reqres.in/api
FAKESTORE_BASE_URL=https://fakestoreapi.com

# ─── Mock de pago local ────────────────────────────────────────────────────────
PAYMENT_MOCK_HOST=127.0.0.1
PAYMENT_MOCK_PORT=8001

# ─── Mock de cola asincrona local ─────────────────────────────────────────────
QUEUE_MOCK_HOST=127.0.0.1
QUEUE_MOCK_PORT=8002
QUEUE_PROCESSING_DELAY_MS=200

# ─── E2E (saucedemo.com como proxy del flujo de onboarding) ───────────────────
E2E_BASE_URL=https://www.saucedemo.com
E2E_USERNAME=standard_user
E2E_PASSWORD=secret_sauce
E2E_HEADLESS=true
E2E_SLOW_MO=0

# ─── Carga ─────────────────────────────────────────────────────────────────────
LOAD_TARGET_HOST=http://127.0.0.1:8001
LOAD_VIRTUAL_USERS=25
LOAD_DURATION=90s
